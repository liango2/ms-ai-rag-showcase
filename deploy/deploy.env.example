# ============================================================================
# ms-ai 环境变量模板 —— 复制成 deploy.env 后再填真实值
#   云机：cp deploy/deploy.env.example /root/ms-ai/deploy.env && vim ...
# ★ deploy.env 绝对不能进 git（.gitignore 已忽略），真实 Key 只存在云机上
# ============================================================================

# 阿里云百炼的 API Key（DashScope），两个模型通道都用这一个
# 获取：阿里云控制台 → 百炼 → API-KEY 管理
DASHSCOPE_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 知识库目录（放 md/txt 学习笔记）。不填则默认 jar 工作目录下的 ./knowledge
# MSAI_KNOWLEDGE_DIR=/root/ms-ai/knowledge
